; Дорожные сцены для вопросов тренажёра. Рендерятся заранее в картинки.
config_version=5

[application]

config/name="Дорожные сцены"
run/main_scene="res://render.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=64
window/size/viewport_height=40
window/size/no_focus=true
window/size/borderless=true
window/vsync/vsync_mode=0
window/size/initial_position_type=0
window/size/initial_position=Vector2i(0, 0)
display_server/driver.linuxbsd="x11"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
textures/default_filters/anisotropic_filtering_level=4

[shader_globals]

island_noise={
"type": "sampler2D",
"value": ""
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
moon_dir={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
daylight={
"type": "float",
"value": 1.0
}
wind={
"type": "vec2",
"value": Vector2(0, 0)
}
