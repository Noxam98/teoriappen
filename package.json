{
  "name": "teoriprove",
  "private": true,
  "version": "1.0.0",
  "description": "Тренажёр норвежского теоретического экзамена на права (класс B) с переводом слов волшебной кистью",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-data.mjs && tsc --noEmit && vite build",
    "build:single": "node scripts/validate-data.mjs && tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs",
    "lab": "vite --open /debug.html",
    "scenes": "node scripts/render-scenes.mjs",
    "scenes:check": "godot --headless --path scenes3d -- check=all"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
